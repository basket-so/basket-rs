# Rebalance keeper image for Fly.io (see fly.toml). Only the bot, its pricing and signed-price
# modules and the program IDL are copied in; .dockerignore keeps keypairs out of the build
# context entirely.
FROM node:22-slim

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY scripts/rebalance-bot.mjs scripts/
COPY scripts/lib/price-oracle.mjs scripts/lib/signed-prices.mjs scripts/lib/
# The bot loads target/idl/basket.json; ship the IDL of the program build with signed prices,
# which the bot is written for. Its account layouts match the program deployed before it, where
# the price oracle account does not exist, so there the bot skips rebalances until the upgrade.
COPY target/idl/basket.json target/idl/basket.json

USER node
CMD ["node", "scripts/rebalance-bot.mjs", "--watch"]
